{
    "name": "borsche/google-drive-docs-bundle",
    "description": "Symfony bundle that turns a Google Shared Drive into a document workspace inside your app: browse folders, create/rename/move/delete Google Sheets & Docs, manage per-item sharing and filter visibility per user.",
    "keywords": [
        "symfony",
        "bundle",
        "google-drive",
        "google-sheets",
        "google-docs",
        "oauth",
        "shared-drive",
        "permissions"
    ],
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Yliy Shcherbak",
            "email": "ylikscherbak@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "google/apiclient": "^2.15",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "symfony/security-core": "^6.4 || ^7.0",
        "phpunit/phpunit": "^10.5",
        "symfony/cache": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0"
    },
    "suggest": {
        "symfony/console": "To run the authorization and check commands",
        "symfony/security-core": "To decide access with is_granted() through DriveVoter"
    },
    "autoload": {
        "psr-4": {
            "Borsche\\GoogleDriveDocsBundle\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Borsche\\GoogleDriveDocsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
